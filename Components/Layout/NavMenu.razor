@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<HeadContent>
    <style>
        .underline-on-hover {
            text-decoration: none; /* Remove the default underline */
        }

        .underline-on-hover:hover {
            text-decoration: underline;
        }
    </style>
</HeadContent>

<div class="d-flex flex-column flex-md-row align-items-center p-4 px-md-4 bg-white box-shadow">
    <nav class="my-2 my-md-0 mr-md-3" style="margin: auto">
        <a class="p-2 text-dark underline-on-hover" href="/">Madplan</a>
        <a class="p-2 text-dark underline-on-hover" href="/retter">Retter</a>
        <a class="p-2 text-dark underline-on-hover" href="/produkter">Produkter</a>
        <a class="p-2 text-dark underline-on-hover" href="/tilbud">Tilbud</a>
        <a class="p-2 text-dark underline-on-hover" href="/statistik">Statistik</a>
        
        <!-- 
            <a class="p-2 text-dark underline-on-hover" @onclick="Logout">Logout</a> 
            <a class="p-2 text-dark underline-on-hover" href="/login">Login</a> 
        -->
        
    </nav>
</div>

